@@ -84,6 +84,7 @@ UdpProtocol::UdpProtocol() :
    _bytes_sent(0),
    _stats_start_time(0),
    _last_send_time(0),
+   _last_sync_request_time(0),
    _shutdown_timeout(0),
    _disconnect_timeout(0),
    _disconnect_notify_start(0),
@@ -294,7 +295,7 @@ UdpProtocol::OnLoopPoll(void *cookie)
    switch (_current_state) {
    case Syncing:
       next_interval = (_state.sync.roundtrips_remaining == NUM_SYNC_PACKETS) ? SYNC_FIRST_RETRY_INTERVAL : SYNC_RETRY_INTERVAL;
